{
  "name": "campusos",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "react-native-video-controls",
          "@fullcalendar/core",
          "@fullcalendar/daygrid",
          "@fullcalendar/interaction",
          "@fullcalendar/list",
          "@fullcalendar/react",
          "@fullcalendar/timegrid",
          "pg",
          "socket.io-client",
          "uuid"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "build": "npx expo export -p web --clear",
    "postbuild": "copy dist\\index.html dist\\404.html 2>nul || cp dist/index.html dist/404.html 2>/dev/null || echo 'Could not create 404.html'",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "vercel-build": "rm -rf node_modules && npm install --legacy-peer-deps && npx expo install --check && npx expo export -p web --clear"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@types/date-fns": "^2.6.0",
    "axios": "^1.10.0",
    "date-fns": "^2.30.0",
    "expo": "~53.0.24",
    "expo-av": "~15.1.7",
    "expo-blur": "~14.1.5",
    "expo-calendar": "~14.1.4",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.7",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "~7.1.7",
    "expo-media-library": "~17.1.7",
    "expo-navigation-bar": "~4.2.8",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.7",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-video-thumbnails": "~9.1.3",
    "expo-web-browser": "~14.2.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-paper": "^5.14.5",
    "react-native-pdf": "^6.7.7",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-video": "^6.16.1",
