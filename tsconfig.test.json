{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": [
            "jest"
        ],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "__mocks__/**/*.ts",
        "__mocks__/**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}